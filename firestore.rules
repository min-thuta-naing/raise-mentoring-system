rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role Checks (checking existence in respective collections)
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isMentor() {
      return isAuthenticated() && exists(/databases/$(database)/documents/mentors/$(request.auth.uid));
    }
    
    function isStudent() {
      return isAuthenticated() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    // --- Collection Rules ---

    // Admins
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == adminId;
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Mentors
    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == mentorId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == mentorId);
    }

    // Students
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == studentId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == studentId);
    }

    // Batches, Modules, Rubrics
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /rubrics/{rubricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Lesson Plans
    match /lessonPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isMentor() && request.resource.data.mentorId == request.auth.uid);
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Group Messages
    match /group_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    // Mentoring Logs
    match /mentoring_logs/{logId} {
      allow read: if isAdmin() || 
                    (isMentor() && resource.data.mentorId == request.auth.uid) ||
                    (isStudent() && resource.data.scores.any(score, score.studentId == request.auth.uid));
      
      allow create: if isAdmin() || isMentor();
      
      allow update: if isAdmin() || 
                      (isMentor() && resource.data.mentorId == request.auth.uid) ||
                      (isStudent() && resource.data.scores.any(score, score.studentId == request.auth.uid));
      
      allow delete: if isAdmin();
    }

    // Mail
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }
  }
}
